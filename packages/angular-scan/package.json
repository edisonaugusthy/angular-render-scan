{
  "name": "angular-scan",
  "version": "0.1.0",
  "description": "Visual Angular change-detection scanner for investor demos.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
